From 798227781f75ca2d59d2e1e4e26c6efbc931c10f Mon Sep 17 00:00:00 2001
From: qwqgong-ui <248246420+qwqgong-ui@users.noreply.github.com>
Date: Fri, 7 Aug 2026 12:45:12 +0800
Subject: [PATCH] dns: prefer IPv6 for upstream hostnames with fallback

---
 docs/config.yaml     |  1 +
 tunnel/dns_dialer.go | 21 +++++++++++----------
 2 files changed, 12 insertions(+), 10 deletions(-)

diff --git a/docs/config.yaml b/docs/config.yaml
index b23a35f2..906dbd67 100644
--- a/docs/config.yaml
+++ b/docs/config.yaml
@@ -303,6 +303,7 @@ dns:
 
   # DNS 主要域名配置
   # 支持 UDP，TCP，DoT，DoH，DoQ
+  # 直连上游地址为域名时默认优先 IPv6；IPv6 不可用或慢于 IPv4 300ms 时自动回退
   # 这部分为主要 DNS 配置，影响所有直连，确保使用对大陆解析精准的 DNS
   nameserver:
     - 114.114.114.114 # default value
diff --git a/tunnel/dns_dialer.go b/tunnel/dns_dialer.go
index c409a298..a98281c5 100644
--- a/tunnel/dns_dialer.go
+++ b/tunnel/dns_dialer.go
@@ -31,7 +31,7 @@ func (d *DNSDialer) DialContext(ctx context.Context, network, addr string) (net.
 	r := d.r
 	proxyName := d.proxyName
 	proxyAdapter := d.proxyAdapter
-	var opts []dialer.Option
+	opts := []dialer.Option{dialer.WithPreferIPv6()}
 	var rule C.Rule
 	metadata := &C.Metadata{
 		NetWork: C.TCP,
@@ -43,14 +43,6 @@ func (d *DNSDialer) DialContext(ctx context.Context, network, addr string) (net.
 	}
 	if !strings.Contains(network, "tcp") {
 		metadata.NetWork = C.UDP
-		if !metadata.Resolved() {
-			// udp must resolve host first
-			dstIP, err := resolver.ResolveIPWithResolver(ctx, metadata.Host, r)
-			if err != nil {
-				return nil, err
-			}
-			metadata.DstIP = dstIP
-		}
 	}
 
 	if proxyAdapter == nil && len(proxyName) != 0 {
@@ -107,7 +99,16 @@ func (d *DNSDialer) DialContext(ctx context.Context, network, addr string) (net.
 		return conn, nil
 	} else {
 		if proxyAdapter == nil {
-			return dialer.DialContext(ctx, network, metadata.AddrPort().String(), opts...)
+			opts = append(opts, dialer.WithResolver(r))
+			return dialer.DialContext(ctx, network, addr, opts...)
+		}
+
+		if !metadata.Resolved() {
+			dstIP, err := resolver.ResolveIPWithResolver(ctx, metadata.Host, r)
+			if err != nil {
+				return nil, err
+			}
+			metadata.DstIP = dstIP
 		}
 
 		if !proxyAdapter.SupportUDP() {
