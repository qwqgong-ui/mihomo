diff --git a/config/ipv6_test.go b/config/ipv6_test.go
new file mode 100644
index 00000000..c0eaf8c
--- /dev/null
+++ b/config/ipv6_test.go
@@ -0,0 +1,66 @@
+package config
+
+import (
+	"net"
+	"net/netip"
+	"testing"
+)
+
+func TestDisableIPv6AlsoDisablesDNS(t *testing.T) {
+	rawCfg := DefaultRawConfig()
+	general := &General{IPv6: true}
+	rawCfg.DNS.IPv6 = true
+	rawCfg.DNS.FakeIPRange6 = "2001:2::/48"
+	rawCfg.Tun.Inet6Address = []netip.Prefix{netip.MustParsePrefix("2001:db8::1/126")}
+
+	disableIPv6(rawCfg, general)
+
+	if general.IPv6 {
+		t.Fatal("runtime IPv6 remained enabled after system IPv6 was unavailable")
+	}
+	if rawCfg.DNS.IPv6 {
+		t.Fatal("DNS IPv6 remained enabled after runtime IPv6 was disabled")
+	}
+	if rawCfg.DNS.FakeIPRange6 != "" {
+		t.Fatalf("DNS fake IPv6 range = %q, want empty", rawCfg.DNS.FakeIPRange6)
+	}
+	if rawCfg.Tun.Inet6Address != nil {
+		t.Fatalf("TUN IPv6 addresses = %v, want nil", rawCfg.Tun.Inet6Address)
+	}
+}
+
+func TestParseIPv6UnavailableDisablesTunAndDNS(t *testing.T) {
+	originalVerifyIP6 := verifyIP6
+	verifyIP6 = func() bool { return false }
+	t.Cleanup(func() { verifyIP6 = originalVerifyIP6 })
+
+	rawCfg := DefaultRawConfig()
+	general := &General{IPv6: true}
+	rawCfg.IPv6 = true
+	rawCfg.DNS.IPv6 = true
+	rawCfg.DNS.FakeIPRange6 = "2001:2::/48"
+	rawCfg.Tun.Inet6Address = []netip.Prefix{netip.MustParsePrefix("fdfe:dcba:9876::1/126")}
+
+	parseIPV6(rawCfg, general)
+
+	if general.IPv6 || rawCfg.DNS.IPv6 || rawCfg.DNS.FakeIPRange6 != "" || rawCfg.Tun.Inet6Address != nil {
+		t.Fatalf("IPv6 shutdown was not synchronized: general=%v dns=%v fake=%q tun=%v", general.IPv6, rawCfg.DNS.IPv6, rawCfg.DNS.FakeIPRange6, rawCfg.Tun.Inet6Address)
+	}
+}
+
+func TestUsableSystemIPv6RejectsTunAndTransitionAddresses(t *testing.T) {
+	if !isIPv6TunnelInterface("Meta") || !isIPv6TunnelInterface("Teredo Tunneling Pseudo-Interface") {
+		t.Fatal("known tunnel interface was accepted")
+	}
+	for _, address := range []string{"fdfe:dcba:9876::1", "2001:0:c612:7::1", "2001:2::1", "2002:c000:0204::1", "fe80::1"} {
+		if isUsableSystemIPv6(netip.MustParseAddr(address)) {
+			t.Fatalf("special-purpose IPv6 address %s was accepted", address)
+		}
+	}
+	if !isUsableSystemIPv6(netip.MustParseAddr("240e::1")) {
+		t.Fatal("native global IPv6 address was rejected")
+	}
+	if isIPv6TunnelInterface((&net.Interface{Name: "Ethernet"}).Name) {
+		t.Fatal("physical interface was rejected")
+	}
+}
