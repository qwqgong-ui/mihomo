+func processLookupEndpoints(metadata *C.Metadata) (src, dst netip.AddrPort) {
+	src = metadata.SourceAddrPort()
+	if rawSrc, ok := addrPortFromNetAddr(metadata.RawSrcAddr); ok {
+		src = rawSrc
+	}
+	dst, _ = addrPortFromNetAddr(metadata.RawDstAddr)
+	return
