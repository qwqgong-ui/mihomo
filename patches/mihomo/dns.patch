+	values := serviceRecordValues(response.Answer[0])
+	require.Contains(t, values, D.SVCB_ECHCONFIG)
+	require.Equal(t, "192.0.2.50", values[D.SVCB_IPV4HINT].(*D.SVCBIPv4Hint).Hint[0].String())
+}
