+	if dialer.count(ipA) != 0 || dialer.count(ipB) != 1 {
+		t.Fatalf("attempt counts = A:%d B:%d; want A:0 B:1", dialer.count(ipA), dialer.count(ipB))
+	}
+}
+
+func TestTCPConcurrentCacheMissStoresFullRaceWinner(t *testing.T) {
