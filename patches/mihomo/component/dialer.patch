+	}
+	v6, _ := r.LookupIPv6(ctx, "")
+	return append(v4, v6...), nil
+}
+
+func (r *controlledLookup) LookupIPv4(ctx context.Context, _ string) ([]netip.Addr, error) {
+	return r.lookup(ctx, r.v4Gate, r.v4)
+}
