+	cache.Set(key, ipB)
+	dialer := newTestTCPDialer(map[netip.Addr][]testDialBehavior{
+		ipA: {{release: closedTestGate()}},
+		ipB: {{release: closedTestGate()}},
+	})
+
+	conn, err := DialContext(
+		context.Background(),
+		"tcp",
+		"example.test:443",
+		WithDirectDualStack(),
