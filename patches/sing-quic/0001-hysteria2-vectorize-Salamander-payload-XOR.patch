diff --git a/hysteria2/xor.go b/hysteria2/xor.go
new file mode 100644
index 0000000..887fcf3
--- /dev/null
+++ b/hysteria2/xor.go
@@ -0,0 +1,9 @@
+package hysteria2
+
+const xorKeySize = 32
+
+func xorKeyStreamGeneric(dst, src []byte, key *[xorKeySize]byte) {
+	for i, c := range src {
+		dst[i] = c ^ key[i&(xorKeySize-1)]
+	}
+}
diff --git a/hysteria2/xor_amd64.go b/hysteria2/xor_amd64.go
new file mode 100644
index 0000000..2f35fbd
--- /dev/null
+++ b/hysteria2/xor_amd64.go
@@ -0,0 +1,24 @@
+//go:build amd64 && !purego
+
+package hysteria2
+
+import "golang.org/x/sys/cpu"
+
+func xorKeyStream(dst, src []byte, key *[xorKeySize]byte) {
+	if len(dst) != len(src) {
+		panic("hysteria2: xor source and destination length mismatch")
+	}
+	if !cpu.X86.HasAVX2 || len(src) < xorKeySize {
+		xorKeyStreamGeneric(dst, src, key)
+		return
+	}
+
+	blocksLen := len(src) &^ (xorKeySize - 1)
+	xorBlocksAVX2(&dst[0], &src[0], blocksLen, key)
+	if blocksLen != len(src) {
+		xorKeyStreamGeneric(dst[blocksLen:], src[blocksLen:], key)
+	}
+}
+
+//go:noescape
+func xorBlocksAVX2(dst, src *byte, n int, key *[xorKeySize]byte)
diff --git a/hysteria2/xor_amd64.s b/hysteria2/xor_amd64.s
new file mode 100644
index 0000000..3de3811
--- /dev/null
+++ b/hysteria2/xor_amd64.s
@@ -0,0 +1,23 @@
+//go:build amd64 && !purego
+
+#include "textflag.h"
+
+// func xorBlocksAVX2(dst, src *byte, n int, key *[32]byte)
+TEXT ·xorBlocksAVX2(SB), NOSPLIT, $0-32
+	MOVQ dst+0(FP), DI
+	MOVQ src+8(FP), SI
+	MOVQ n+16(FP), CX
+	MOVQ key+24(FP), AX
+	VMOVDQU (AX), Y0
+
+loop:
+	VMOVDQU (SI), Y1
+	VPXOR Y0, Y1, Y1
+	VMOVDQU Y1, (DI)
+	ADDQ $32, SI
+	ADDQ $32, DI
+	SUBQ $32, CX
+	JNZ loop
+
+	VZEROUPPER
+	RET
diff --git a/hysteria2/xor_arm64.go b/hysteria2/xor_arm64.go
new file mode 100644
index 0000000..f0cd478
--- /dev/null
+++ b/hysteria2/xor_arm64.go
@@ -0,0 +1,22 @@
+//go:build arm64 && !purego
+
+package hysteria2
+
+func xorKeyStream(dst, src []byte, key *[xorKeySize]byte) {
+	if len(dst) != len(src) {
+		panic("hysteria2: xor source and destination length mismatch")
+	}
+	if len(src) < xorKeySize {
+		xorKeyStreamGeneric(dst, src, key)
+		return
+	}
+
+	blocksLen := len(src) &^ (xorKeySize - 1)
+	xorBlocksNEON(&dst[0], &src[0], blocksLen, key)
+	if blocksLen != len(src) {
+		xorKeyStreamGeneric(dst[blocksLen:], src[blocksLen:], key)
+	}
+}
+
+//go:noescape
+func xorBlocksNEON(dst, src *byte, n int, key *[xorKeySize]byte)
diff --git a/hysteria2/xor_arm64.s b/hysteria2/xor_arm64.s
new file mode 100644
index 0000000..cea13e9
--- /dev/null
+++ b/hysteria2/xor_arm64.s
@@ -0,0 +1,20 @@
+//go:build arm64 && !purego
+
+#include "textflag.h"
+
+// func xorBlocksNEON(dst, src *byte, n int, key *[32]byte)
+TEXT ·xorBlocksNEON(SB), NOSPLIT, $0-32
+	MOVD dst+0(FP), R0
+	MOVD src+8(FP), R1
+	MOVD n+16(FP), R2
+	MOVD key+24(FP), R3
+	VLD1 (R3), [V0.B16, V1.B16]
+
+loop:
+	VLD1.P 32(R1), [V2.B16, V3.B16]
+	VEOR V0.B16, V2.B16, V2.B16
+	VEOR V1.B16, V3.B16, V3.B16
+	VST1.P [V2.B16, V3.B16], 32(R0)
+	SUBS $32, R2
+	BNE loop
+	RET
diff --git a/hysteria2/xor_generic.go b/hysteria2/xor_generic.go
new file mode 100644
index 0000000..a10d678
--- /dev/null
+++ b/hysteria2/xor_generic.go
@@ -0,0 +1,10 @@
+//go:build (!amd64 && !arm64) || purego
+
+package hysteria2
+
+func xorKeyStream(dst, src []byte, key *[xorKeySize]byte) {
+	if len(dst) != len(src) {
+		panic("hysteria2: xor source and destination length mismatch")
+	}
+	xorKeyStreamGeneric(dst, src, key)
+}
diff --git a/hysteria2/xor_test.go b/hysteria2/xor_test.go
new file mode 100644
index 0000000..1faaa75
--- /dev/null
+++ b/hysteria2/xor_test.go
@@ -0,0 +1,63 @@
+package hysteria2
+
+import (
+	"bytes"
+	"math/rand"
+	"strconv"
+	"testing"
+)
+
+func TestXorKeyStream(t *testing.T) {
+	var key [xorKeySize]byte
+	for i := range key {
+		key[i] = byte(i*7 + 3)
+	}
+
+	for n := 0; n <= 4096; n++ {
+		src := make([]byte, n)
+		_, _ = rand.New(rand.NewSource(int64(n))).Read(src)
+		want := make([]byte, n)
+		xorKeyStreamGeneric(want, src, &key)
+
+		got := make([]byte, n)
+		xorKeyStream(got, src, &key)
+		if !bytes.Equal(got, want) {
+			t.Fatalf("separate buffers, length %d: result mismatch", n)
+		}
+
+		got = bytes.Clone(src)
+		xorKeyStream(got, got, &key)
+		if !bytes.Equal(got, want) {
+			t.Fatalf("in-place, length %d: result mismatch", n)
+		}
+
+		got = make([]byte, n+salamanderSaltLen)
+		copy(got[salamanderSaltLen:], src)
+		xorKeyStream(got[:n], got[salamanderSaltLen:], &key)
+		if !bytes.Equal(got[:n], want) {
+			t.Fatalf("overlap, length %d: result mismatch", n)
+		}
+	}
+}
+
+func BenchmarkXorKeyStream(b *testing.B) {
+	var key [xorKeySize]byte
+	for _, size := range []int{300, 1200, 4096} {
+		src := make([]byte, size)
+		dst := make([]byte, size)
+		b.Run(strconv.Itoa(size), func(b *testing.B) {
+			b.Run("dispatch", func(b *testing.B) {
+				b.SetBytes(int64(size))
+				for i := 0; i < b.N; i++ {
+					xorKeyStream(dst, src, &key)
+				}
+			})
+			b.Run("generic", func(b *testing.B) {
+				b.SetBytes(int64(size))
+				for i := 0; i < b.N; i++ {
+					xorKeyStreamGeneric(dst, src, &key)
+				}
+			})
+		})
+	}
+}
