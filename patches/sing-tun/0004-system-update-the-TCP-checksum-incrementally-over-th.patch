diff --git a/stack_system_checksum.go b/stack_system_checksum.go
new file mode 100644
index 0000000..4729be1
--- /dev/null
+++ b/stack_system_checksum.go
@@ -0,0 +1,59 @@
+package tun
+
+import (
+	"encoding/binary"
+	"net/netip"
+)
+
+// checksumDelta incrementally updates a one's complement checksum whose
+// covered data changed only in a few known 16-bit words, following the
+// HC' = ~(~HC + ~m + m') form of RFC 1624 eqn. 3.
+//
+// The system stack rewrites the addresses and ports of every forwarded TCP
+// packet, which are the only inputs of the TCP checksum that change: the
+// payload, the length and the protocol in the pseudo header all stay as they
+// were. Folding those few words in costs a handful of adds, while re-summing
+// the packet is a full pass over up to 64 KiB of coalesced payload.
+type checksumDelta struct {
+	acc uint32
+}
+
+func (d *checksumDelta) addUint16(oldValue uint16, newValue uint16) {
+	if oldValue == newValue {
+		return
+	}
+	d.acc += uint32(^oldValue) + uint32(newValue)
+}
+
+func (d *checksumDelta) addAddr4(oldValue netip.Addr, newValue netip.Addr) {
+	if oldValue == newValue {
+		return
+	}
+	oldBytes, newBytes := oldValue.As4(), newValue.As4()
+	for i := 0; i < 4; i += 2 {
+		d.addUint16(binary.BigEndian.Uint16(oldBytes[i:]), binary.BigEndian.Uint16(newBytes[i:]))
+	}
+}
+
+func (d *checksumDelta) addAddr16(oldValue netip.Addr, newValue netip.Addr) {
+	if oldValue == newValue {
+		return
+	}
+	oldBytes, newBytes := oldValue.As16(), newValue.As16()
+	for i := 0; i < 16; i += 2 {
+		d.addUint16(binary.BigEndian.Uint16(oldBytes[i:]), binary.BigEndian.Uint16(newBytes[i:]))
+	}
+}
+
+// apply returns the checksum that old becomes once every recorded change is
+// accounted for.
+func (d *checksumDelta) apply(old uint16) uint16 {
+	if d.acc == 0 {
+		return old
+	}
+	sum := uint32(^old) + d.acc
+	for sum>>16 != 0 {
+		sum = sum&0xFFFF + sum>>16
+	}
+	return ^uint16(sum)
+}
diff --git a/stack_system_checksum_test.go b/stack_system_checksum_test.go
new file mode 100644
index 0000000..c0b108c
--- /dev/null
+++ b/stack_system_checksum_test.go
@@ -0,0 +1,127 @@
+package tun
+
+import (
+	"math/rand"
+	"net/netip"
+	"testing"
+
+	"github.com/metacubex/sing-tun/internal/gtcpip/checksum"
+	"github.com/metacubex/sing-tun/internal/gtcpip/header"
+)
+
+func fullTCPChecksum4(ipHdr header.IPv4, tcpHdr header.TCP) uint16 {
+	return ^checksum.Checksum(tcpHdr.Payload(), tcpHdr.CalculateChecksum(
+		header.PseudoHeaderChecksum(header.TCPProtocolNumber, ipHdr.SourceAddressSlice(), ipHdr.DestinationAddressSlice(), ipHdr.PayloadLength()),
+	))
+}
+
+func fullTCPChecksum6(ipHdr header.IPv6, tcpHdr header.TCP) uint16 {
+	return ^checksum.Checksum(tcpHdr.Payload(), tcpHdr.CalculateChecksum(
+		header.PseudoHeaderChecksum(header.TCPProtocolNumber, ipHdr.SourceAddressSlice(), ipHdr.DestinationAddressSlice(), ipHdr.PayloadLength()),
+	))
+}
+
+func randomAddr(random *rand.Rand, v6 bool) netip.Addr {
+	if v6 {
+		var raw [16]byte
+		random.Read(raw[:])
+		return netip.AddrFrom16(raw)
+	}
+	var raw [4]byte
+	random.Read(raw[:])
+	return netip.AddrFrom4(raw)
+}
+
+func TestChecksumDeltaMatchesFullTCPChecksum4(t *testing.T) {
+	t.Parallel()
+	random := rand.New(rand.NewSource(1))
+	for i := 0; i < 2000; i++ {
+		payloadLen := random.Intn(1400)
+		packet := make([]byte, header.IPv4MinimumSize+header.TCPMinimumSize+payloadLen)
+		random.Read(packet[header.IPv4MinimumSize+header.TCPMinimumSize:])
+		ipHdr := header.IPv4(packet)
+		ipHdr.Encode(&header.IPv4Fields{
+			TotalLength: uint16(len(packet)),
+			Protocol:    uint8(header.TCPProtocolNumber),
+			SrcAddr:     randomAddr(random, false),
+			DstAddr:     randomAddr(random, false),
+		})
+		tcpHdr := header.TCP(ipHdr.Payload())
+		tcpHdr.Encode(&header.TCPFields{
+			SrcPort:    uint16(random.Intn(65536)),
+			DstPort:    uint16(random.Intn(65536)),
+			DataOffset: header.TCPMinimumSize,
+			Flags:      header.TCPFlagAck,
+			WindowSize: 1024,
+		})
+		tcpHdr.SetChecksum(fullTCPChecksum4(ipHdr, tcpHdr))
+
+		oldSource, oldDestination := ipHdr.SourceAddr(), ipHdr.DestinationAddr()
+		oldSourcePort, oldDestinationPort := tcpHdr.SourcePort(), tcpHdr.DestinationPort()
+
+		ipHdr.SetSourceAddr(randomAddr(random, false))
+		ipHdr.SetDestinationAddr(randomAddr(random, false))
+		tcpHdr.SetSourcePort(uint16(random.Intn(65536)))
+		tcpHdr.SetDestinationPort(uint16(random.Intn(65536)))
+
+		var delta checksumDelta
+		delta.addAddr4(oldSource, ipHdr.SourceAddr())
+		delta.addAddr4(oldDestination, ipHdr.DestinationAddr())
+		delta.addUint16(oldSourcePort, tcpHdr.SourcePort())
+		delta.addUint16(oldDestinationPort, tcpHdr.DestinationPort())
+		got := delta.apply(tcpHdr.Checksum())
+
+		tcpHdr.SetChecksum(0)
+		want := fullTCPChecksum4(ipHdr, tcpHdr)
+		if got != want {
+			t.Fatalf("iteration %d: incremental checksum %#04x, full checksum %#04x", i, got, want)
+		}
+	}
+}
+
+func TestChecksumDeltaMatchesFullTCPChecksum6(t *testing.T) {
+	t.Parallel()
+	random := rand.New(rand.NewSource(2))
+	for i := 0; i < 2000; i++ {
+		payloadLen := random.Intn(1400)
+		packet := make([]byte, header.IPv6MinimumSize+header.TCPMinimumSize+payloadLen)
+		random.Read(packet[header.IPv6MinimumSize+header.TCPMinimumSize:])
+		ipHdr := header.IPv6(packet)
+		ipHdr.Encode(&header.IPv6Fields{
+			PayloadLength:     uint16(header.TCPMinimumSize + payloadLen),
+			TransportProtocol: header.TCPProtocolNumber,
+			SrcAddr:           randomAddr(random, true),
+			DstAddr:           randomAddr(random, true),
+		})
+		tcpHdr := header.TCP(ipHdr.Payload())
+		tcpHdr.Encode(&header.TCPFields{
+			SrcPort:    uint16(random.Intn(65536)),
+			DstPort:    uint16(random.Intn(65536)),
+			DataOffset: header.TCPMinimumSize,
+			Flags:      header.TCPFlagAck,
+			WindowSize: 1024,
+		})
+		tcpHdr.SetChecksum(fullTCPChecksum6(ipHdr, tcpHdr))
+
+		oldSource, oldDestination := ipHdr.SourceAddr(), ipHdr.DestinationAddr()
+		oldSourcePort, oldDestinationPort := tcpHdr.SourcePort(), tcpHdr.DestinationPort()
+
+		ipHdr.SetSourceAddr(randomAddr(random, true))
+		ipHdr.SetDestinationAddr(randomAddr(random, true))
+		tcpHdr.SetSourcePort(uint16(random.Intn(65536)))
+		tcpHdr.SetDestinationPort(uint16(random.Intn(65536)))
+
+		var delta checksumDelta
+		delta.addAddr16(oldSource, ipHdr.SourceAddr())
+		delta.addAddr16(oldDestination, ipHdr.DestinationAddr())
+		delta.addUint16(oldSourcePort, tcpHdr.SourcePort())
+		delta.addUint16(oldDestinationPort, tcpHdr.DestinationPort())
+		got := delta.apply(tcpHdr.Checksum())
+
+		tcpHdr.SetChecksum(0)
+		want := fullTCPChecksum6(ipHdr, tcpHdr)
+		if got != want {
+			t.Fatalf("iteration %d: incremental checksum %#04x, full checksum %#04x", i, got, want)
+		}
+	}
+}
